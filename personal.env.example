# ===== 复制为 personal.env 并填入你自己的路径 (personal.env 已被 .gitignore 排除) =====
# 你的声音 (docs/ONBOARDING.md 第1步)
export VOICE_REF="/path/to/your/voice_ref.wav"        # 音色参考: 平稳叙述 20-30s
export EMO_REF="/path/to/your/emo_ref.wav"            # 情感参考: 自然聊天 20-30s
# 你的形象与品牌 (第2/3步) — 目录下放 template2_720.mp4 / ending.mov / ending_voice.wav
export PERSONAL_ASSETS="/path/to/your/personal-assets"
# 封面本人胸像的参考照: 正脸、白底抠像 (SKILL.md 步骤8 默认封面格式); 衣服轮换历史也记在 $PERSONAL_ASSETS 下
export COVER_FACE_REF="$PERSONAL_ASSETS/cover_face_ref.jpg"
# 引擎安装位置 (第4步)
export ITTS_HOME="/path/to/index-tts"
export W2L_HOME="/path/to/wav2lip-onnx-256"
# 你的 ChatGPT 文案项目 (SKILL.md 步骤1 直达用)
export GPT_PROJECT_URL="https://chatgpt.com/g/g-p-<你的项目ID>/project"
# 可选旋钮
export EMO_ALPHA="1.0"          # 情感浓度 0-1
export SPEECH_TEMPO="1.0"       # 语速 (1.0=原生)
